# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Base URL of the public site — used to build payment links (e.g. https://scc.com/pay/<token>)
PUBLIC_APP_URL=http://localhost:3001

# ─── Database (PostgreSQL) ─────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=scc
# Schema management: keep synchronize OFF and use migrations (production-safe).
# Dev shortcut: set DB_SYNCHRONIZE=true to auto-sync schema from entities.
DB_SYNCHRONIZE=false
# Run any pending migrations automatically when the app boots.
DB_MIGRATIONS_RUN=true

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Email (Resend) — provide the key later ────────────
# When RESEND_API_KEY is empty, emails are logged to console instead of sent.
# Get a key at https://resend.com. EMAIL_FROM must be on a domain you've
# verified in Resend (or use onboarding@resend.dev for testing).
RESEND_API_KEY=
EMAIL_FROM=no-reply@scc.example.com
EMAIL_FROM_NAME=SCC Venue

# ─── Payments ──────────────────────────────────────────
# Payment links default to a 24h due date from generation if the admin doesn't set one
MAX_PAYMENT_REJECTIONS=3

# ─── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Object storage (S3-compatible: Railway/Tigris, Cloudflare R2, AWS S3) ─
# When all S3_* are set, uploads go to the bucket; otherwise they fall back to
# local disk (UPLOAD_DIR). Files are served back through the API at /files/:key,
# so nothing else needs to know where they live.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Seed admin (created by `npm run seed`) ────────────
SEED_ADMIN_EMAIL=admin@scc.example.com
SEED_ADMIN_PASSWORD=admin12345
