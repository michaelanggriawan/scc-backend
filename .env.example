# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Base URL of the public site — used to build payment links (e.g. https://scc.com/pay/<token>)
PUBLIC_APP_URL=http://localhost:5173

# ─── Database (PostgreSQL) ─────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=scc
# Set true only for local dev; use migrations in production
DB_SYNCHRONIZE=true

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Email (SendGrid) — provide the key later ──────────
# When SENDGRID_API_KEY is empty, emails are logged to console instead of sent.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@scc.example.com
EMAIL_FROM_NAME=SCC Venue

# ─── Payments ──────────────────────────────────────────
# Default number of days a payment link stays valid if admin doesn't set a due date
PAYMENT_LINK_DEFAULT_DAYS=7
MAX_PAYMENT_REJECTIONS=3

# ─── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Seed admin (created by `npm run seed`) ────────────
SEED_ADMIN_EMAIL=admin@scc.example.com
SEED_ADMIN_PASSWORD=admin12345
